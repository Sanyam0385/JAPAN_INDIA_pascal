# CIRCULO Mobile App — Environment Variables
# Copy this file to .env to enable production backend integration

# Supabase Project URL & Anon Key (from your Supabase dashboard -> Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: If these variables are not provided, CIRCULO automatically operates
# in standalone Hackathon Demo Mode with in-memory persistence and full cross-role simulation.
